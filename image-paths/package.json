{
  "name": "dsh-image-paths",
  "version": "0.1.0",
  "private": true,
  "description": "Render local image paths written in assistant prose as inline images in the dsh web chat.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "package.json"
  ]
}
