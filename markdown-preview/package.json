{
  "name": "dsh-markdown-preview",
  "version": "0.2.0",
  "private": true,
  "description": "A Markdown preview drawer beside the dsh chat: the shell's own renderer (TeX, code, tables, footnotes) plus a document's local images.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "package.json"
  ]
}
